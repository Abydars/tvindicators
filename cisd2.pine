//@version=6
indicator(
     "15m Sweep + 1m Body CISD + Position Blocks",
     overlay = true,
     max_lines_count = 500,
     max_labels_count = 500,
     max_boxes_count = 500
)

//──────────────────────────────────────────────────────────────────────────────
// Fixed settings
//──────────────────────────────────────────────────────────────────────────────

string TZ = "Asia/Karachi"

color SWEEP_COLOR = color.rgb(41, 98, 255)
color BULL_CISD_COLOR = color.rgb(0, 170, 120)
color BEAR_CISD_COLOR = color.rgb(220, 60, 70)

color PROFIT_BLOCK_COLOR = color.rgb(0, 170, 120)
color RISK_BLOCK_COLOR = color.rgb(220, 60, 70)
color POSITION_BORDER_COLOR = color.rgb(110, 110, 110)

int MAX_15M_HISTORY = 40
int MAX_SAVED_LINES = 480
int MAX_SAVED_LABELS = 480

int SL_BUFFER_TICKS = 1

int POSITION_BLOCK_LENGTH = 15
int POSITION_BLOCK_TRANSPARENCY = 82

float MIN_TP_R_MULTIPLE = 1.5
float IDEAL_TP_R_MULTIPLE = 2.0
float MAX_TP_R_MULTIPLE = 4.0
float TARGET_ATR_BUFFER = 0.10

string TARGET_TIMEFRAME = "60"

int H1_PIVOT_LEFT = 2
int H1_PIVOT_RIGHT = 2
int MAX_H1_TARGETS = 30

bool isOneMinute =
     timeframe.isminutes and
     timeframe.multiplier == 1

//──────────────────────────────────────────────────────────────────────────────
// Pakistan sessions
//──────────────────────────────────────────────────────────────────────────────

bool sessionOne =
     not na(time(timeframe.period, "1100-1400", TZ))

bool sessionTwo =
     not na(time(timeframe.period, "1800-1930", TZ))

bool insideSession =
     sessionOne or sessionTwo

bool sessionStarted =
     insideSession and
     not insideSession[1]

bool sessionEnded =
     not insideSession and
     insideSession[1]

bgcolor(
     insideSession ? color.new(color.gray, 90) : na,
     title = "Pakistan Sessions"
)

//──────────────────────────────────────────────────────────────────────────────
// Drawing storage
//──────────────────────────────────────────────────────────────────────────────

var array<line> savedLines = array.new_line()
var array<label> savedLabels = array.new_label()

f_saveLine(line newLine) =>
    array.push(savedLines, newLine)

    if array.size(savedLines) > MAX_SAVED_LINES
        line oldLine = array.shift(savedLines)
        line.delete(oldLine)

f_saveLabel(label newLabel) =>
    array.push(savedLabels, newLabel)

    if array.size(savedLabels) > MAX_SAVED_LABELS
        label oldLabel = array.shift(savedLabels)
        label.delete(oldLabel)

var array<box> savedBoxes = array.new_box()

f_saveBox(box newBox) =>
    array.push(savedBoxes, newBox)

    if array.size(savedBoxes) > 200
        box oldBox = array.shift(savedBoxes)
        box.delete(oldBox)

//──────────────────────────────────────────────────────────────────────────────
// Draw a horizontal trade level
//──────────────────────────────────────────────────────────────────────────────

f_drawPositionBlock(
     int startBar,
     float entryPrice,
     float stopPrice,
     float targetPrice,
     int direction
 ) =>
    int endBar =
         startBar + POSITION_BLOCK_LENGTH

    float rewardTop =
         direction == 1
         ? targetPrice
         : entryPrice

    float rewardBottom =
         direction == 1
         ? entryPrice
         : targetPrice

    float riskTop =
         direction == 1
         ? entryPrice
         : stopPrice

    float riskBottom =
         direction == 1
         ? stopPrice
         : entryPrice

    box rewardBox = box.new(
         left = startBar,
         top = rewardTop,
         right = endBar,
         bottom = rewardBottom,
         xloc = xloc.bar_index,
         border_color = color.new(
              PROFIT_BLOCK_COLOR,
              25
         ),
         border_width = 1,
         bgcolor = color.new(
              PROFIT_BLOCK_COLOR,
              POSITION_BLOCK_TRANSPARENCY
         )
    )

    box riskBox = box.new(
         left = startBar,
         top = riskTop,
         right = endBar,
         bottom = riskBottom,
         xloc = xloc.bar_index,
         border_color = color.new(
              RISK_BLOCK_COLOR,
              25
         ),
         border_width = 1,
         bgcolor = color.new(
              RISK_BLOCK_COLOR,
              POSITION_BLOCK_TRANSPARENCY
         )
    )

    line entryLine = line.new(
         x1 = startBar,
         y1 = entryPrice,
         x2 = endBar,
         y2 = entryPrice,
         xloc = xloc.bar_index,
         extend = extend.none,
         color = POSITION_BORDER_COLOR,
         width = 1,
         style = line.style_dashed
    )

    f_saveBox(rewardBox)
    f_saveBox(riskBox)
    f_saveLine(entryLine)

//──────────────────────────────────────────────────────────────────────────────
// Draw completed setup
//
// direction:
//  1 = bullish
// -1 = bearish
//──────────────────────────────────────────────────────────────────────────────

f_drawSetup(
     int sweepTime,
     float sweepPrice,
     float sweepExtreme,
     int cisdSourceBar,
     float cisdPrice,
     int confirmationBar,
     float entryPrice,
     float target15m,
     float target1h,
     int direction
 ) =>
    color cisdColor =
         direction == 1
         ? BULL_CISD_COLOR
         : BEAR_CISD_COLOR

    float slBuffer =
         syminfo.mintick * SL_BUFFER_TICKS

    float stopPrice =
         direction == 1
         ? sweepExtreme - slBuffer
         : sweepExtreme + slBuffer

    float risk =
         direction == 1
         ? entryPrice - stopPrice
         : stopPrice - entryPrice

    bool validRisk =
         risk > syminfo.mintick

    float minimumTarget =
         validRisk
         ? direction == 1
              ? entryPrice + risk * MIN_TP_R_MULTIPLE
              : entryPrice - risk * MIN_TP_R_MULTIPLE
         : na

    float fallbackTarget =
         validRisk
         ? direction == 1
              ? entryPrice + risk * IDEAL_TP_R_MULTIPLE
              : entryPrice - risk * IDEAL_TP_R_MULTIPLE
         : na

    float maximumTarget =
         validRisk
         ? direction == 1
              ? entryPrice + risk * MAX_TP_R_MULTIPLE
              : entryPrice - risk * MAX_TP_R_MULTIPLE
         : na

    bool valid15mTarget =
         not na(target15m) and not na(minimumTarget) and not na(maximumTarget) and
         (
              direction == 1
              ? (target15m >= minimumTarget and target15m <= maximumTarget)
              : (target15m <= minimumTarget and target15m >= maximumTarget)
         )

    bool valid1hTarget =
         not na(target1h) and not na(minimumTarget) and not na(maximumTarget) and
         (
              direction == 1
              ? (target1h >= minimumTarget and target1h <= maximumTarget)
              : (target1h <= minimumTarget and target1h >= maximumTarget)
         )

    float rawTarget =
         valid15mTarget
         ? target15m
         : valid1hTarget
              ? target1h
              : na

    float finalTarget = na

    if not na(rawTarget)
        float targetBuffer =
             ta.atr(14) * TARGET_ATR_BUFFER

        float bufferedTarget =
             direction == 1
             ? rawTarget - targetBuffer
             : rawTarget + targetBuffer

        if direction == 1
            finalTarget :=
                 math.min(
                      math.max(
                           bufferedTarget,
                           minimumTarget
                      ),
                      maximumTarget
                 )
        else
            finalTarget :=
                 math.max(
                      math.min(
                           bufferedTarget,
                           minimumTarget
                      ),
                      maximumTarget
                 )
    else
        finalTarget := fallbackTarget

    line sweepLine = line.new(
         x1 = sweepTime,
         y1 = sweepPrice,
         x2 = time,
         y2 = sweepPrice,
         xloc = xloc.bar_time,
         extend = extend.none,
         color = SWEEP_COLOR,
         width = 1
     )

    line cisdLine = line.new(
         x1 = cisdSourceBar,
         y1 = cisdPrice,
         x2 = confirmationBar,
         y2 = cisdPrice,
         xloc = xloc.bar_index,
         extend = extend.none,
         color = cisdColor,
         width = 2
     )

    label sweepLabel = label.new(
         x = sweepTime,
         y = sweepPrice,
         text = "Sweep",
         xloc = xloc.bar_time,
         yloc = yloc.price,
         style = label.style_none,
         textcolor = SWEEP_COLOR,
         size = size.small
     )

    label cisdLabel = label.new(
         x = confirmationBar,
         y = cisdPrice,
         text = direction == 1
              ? "Bull CISD"
              : "Bear CISD",
         xloc = xloc.bar_index,
         yloc = yloc.price,
         style = direction == -1
              ? label.style_label_down
              : label.style_label_up,
         color = color.new(color.white, 100),
         textcolor = cisdColor,
         size = size.small
     )

    f_saveLine(sweepLine)
    f_saveLine(cisdLine)

    f_saveLabel(sweepLabel)
    f_saveLabel(cisdLabel)

    bool validPosition =
         validRisk and
         not na(finalTarget) and
         (
              direction == 1
              ? finalTarget > entryPrice
              : finalTarget < entryPrice
         )

    if validPosition
        f_drawPositionBlock(
             confirmationBar,
             entryPrice,
             stopPrice,
             finalTarget,
             direction
        )

//──────────────────────────────────────────────────────────────────────────────
// Completed 15m candle history
//──────────────────────────────────────────────────────────────────────────────

var array<int> completed15Times = array.new_int()
var array<float> completed15Highs = array.new_float()
var array<float> completed15Lows = array.new_float()

var array<bool> completed15HighSwept = array.new_bool()
var array<bool> completed15LowSwept = array.new_bool()

f_store15m(
     int candleTime,
     float candleHigh,
     float candleLow
 ) =>
    array.push(completed15Times, candleTime)
    array.push(completed15Highs, candleHigh)
    array.push(completed15Lows, candleLow)

    array.push(completed15HighSwept, false)
    array.push(completed15LowSwept, false)

    if array.size(completed15Times) > MAX_15M_HISTORY
        array.shift(completed15Times)
        array.shift(completed15Highs)
        array.shift(completed15Lows)

        array.shift(completed15HighSwept)
        array.shift(completed15LowSwept)

//──────────────────────────────────────────────────────────────────────────────
// Find most recent unswept previous 15m high that was swept
//──────────────────────────────────────────────────────────────────────────────

f_findSweptHigh(float candleHigh) =>
    float foundPrice = na
    int foundTime = na
    int foundIndex = na

    int count =
         array.size(completed15Highs)

    if count > 0
        for offset = 0 to count - 1
            int index =
                 count - 1 - offset

            float level =
                 array.get(
                      completed15Highs,
                      index
                 )

            bool alreadySwept =
                 array.get(
                      completed15HighSwept,
                      index
                 )

            if not alreadySwept and
               candleHigh > level

                foundPrice := level

                foundTime :=
                     array.get(
                          completed15Times,
                          index
                     )

                foundIndex := index
                break

    [foundPrice,foundTime,foundIndex]

//──────────────────────────────────────────────────────────────────────────────
// Find most recent unswept previous 15m low that was swept
//──────────────────────────────────────────────────────────────────────────────

f_findSweptLow(float candleLow) =>
    float foundPrice = na
    int foundTime = na
    int foundIndex = na

    int count =
         array.size(completed15Lows)

    if count > 0
        for offset = 0 to count - 1
            int index =
                 count - 1 - offset

            float level =
                 array.get(
                      completed15Lows,
                      index
                 )

            bool alreadySwept =
                 array.get(
                      completed15LowSwept,
                      index
                 )

            if not alreadySwept and
               candleLow < level

                foundPrice := level

                foundTime :=
                     array.get(
                          completed15Times,
                          index
                     )

                foundIndex := index
                break

    [foundPrice,foundTime,foundIndex]

f_findTargetHigh(float referencePrice) =>
    float targetPrice = na

    int count =
         array.size(completed15Highs)

    if count > 0
        for index = 0 to count - 1
            float level =
                 array.get(
                      completed15Highs,
                      index
                 )

            bool alreadySwept =
                 array.get(
                      completed15HighSwept,
                      index
                 )

            bool validLevel =
                 not alreadySwept and
                 level > referencePrice

            if validLevel
                targetPrice :=
                     na(targetPrice)
                     ? level
                     : math.min(
                          targetPrice,
                          level
                     )

    targetPrice

//──────────────────────────────────────────────────────────────────────────────
// Find lowest unswept 15m low below price
//
// Bearish target: external sellside liquidity.
//──────────────────────────────────────────────────────────────────────────────

f_findTargetLow(float referencePrice) =>
    float targetPrice = na

    int count =
         array.size(completed15Lows)

    if count > 0
        for index = 0 to count - 1
            float level =
                 array.get(
                      completed15Lows,
                      index
                 )

            bool alreadySwept =
                 array.get(
                      completed15LowSwept,
                      index
                 )

            bool validLevel =
                 not alreadySwept and
                 level < referencePrice

            if validLevel
                targetPrice :=
                     na(targetPrice)
                     ? level
                     : math.max(
                          targetPrice,
                          level
                     )

    targetPrice

//──────────────────────────────────────────────────────────────────────────────
// Confirmed 1H swing liquidity targets
//──────────────────────────────────────────────────────────────────────────────

[h1PivotHigh, h1PivotHighTime] = request.security(
     syminfo.tickerid,
     TARGET_TIMEFRAME,
     [
          ta.pivothigh(
               high,
               H1_PIVOT_LEFT,
               H1_PIVOT_RIGHT
          ),
          not na(
               ta.pivothigh(
                    high,
                    H1_PIVOT_LEFT,
                    H1_PIVOT_RIGHT
               )
          )
          ? time[H1_PIVOT_RIGHT]
          : na
     ],
     lookahead = barmerge.lookahead_off
)

[h1PivotLow, h1PivotLowTime] = request.security(
     syminfo.tickerid,
     TARGET_TIMEFRAME,
     [
          ta.pivotlow(
               low,
               H1_PIVOT_LEFT,
               H1_PIVOT_RIGHT
          ),
          not na(
               ta.pivotlow(
                    low,
                    H1_PIVOT_LEFT,
                    H1_PIVOT_RIGHT
               )
          )
          ? time[H1_PIVOT_RIGHT]
          : na
     ],
     lookahead = barmerge.lookahead_off
)

var array<float> h1TargetHighs = array.new_float()
var array<float> h1TargetLows = array.new_float()

var array<bool> h1TargetHighSwept = array.new_bool()
var array<bool> h1TargetLowSwept = array.new_bool()

bool newH1PivotHigh =
     not na(h1PivotHigh) and
     not na(h1PivotHighTime) and
     (
          na(h1PivotHighTime[1]) or
          h1PivotHighTime != h1PivotHighTime[1]
     )

bool newH1PivotLow =
     not na(h1PivotLow) and
     not na(h1PivotLowTime) and
     (
          na(h1PivotLowTime[1]) or
          h1PivotLowTime != h1PivotLowTime[1]
     )

if newH1PivotHigh
    array.push(
         h1TargetHighs,
         h1PivotHigh
    )

    array.push(
         h1TargetHighSwept,
         false
    )

    if array.size(h1TargetHighs) > MAX_H1_TARGETS
        array.shift(h1TargetHighs)
        array.shift(h1TargetHighSwept)

if newH1PivotLow
    array.push(
         h1TargetLows,
         h1PivotLow
    )

    array.push(
         h1TargetLowSwept,
         false
    )

    if array.size(h1TargetLows) > MAX_H1_TARGETS
        array.shift(h1TargetLows)
        array.shift(h1TargetLowSwept)

// Mark old 1H liquidity as swept.
int h1HighCount =
     array.size(h1TargetHighs)

if h1HighCount > 0
    for index = 0 to h1HighCount - 1
        bool alreadySwept =
             array.get(
                  h1TargetHighSwept,
                  index
             )

        float level =
             array.get(
                  h1TargetHighs,
                  index
             )

        if not alreadySwept and high > level
            array.set(
                 h1TargetHighSwept,
                 index,
                 true
            )

int h1LowCount =
     array.size(h1TargetLows)

if h1LowCount > 0
    for index = 0 to h1LowCount - 1
        bool alreadySwept =
             array.get(
                  h1TargetLowSwept,
                  index
             )

        float level =
             array.get(
                  h1TargetLows,
                  index
             )

        if not alreadySwept and low < level
            array.set(
                 h1TargetLowSwept,
                 index,
                 true
            )

//──────────────────────────────────────────────────────────────────────────────
// Nearest unswept confirmed 1H high
//──────────────────────────────────────────────────────────────────────────────

f_findH1TargetHigh(float referencePrice) =>
    float targetPrice = na

    int count =
         array.size(h1TargetHighs)

    if count > 0
        for index = 0 to count - 1
            float level =
                 array.get(
                      h1TargetHighs,
                      index
                 )

            bool alreadySwept =
                 array.get(
                      h1TargetHighSwept,
                      index
                 )

            if not alreadySwept and
               level > referencePrice

                targetPrice :=
                     na(targetPrice)
                     ? level
                     : math.min(
                          targetPrice,
                          level
                     )

    targetPrice

//──────────────────────────────────────────────────────────────────────────────
// Nearest unswept confirmed 1H low
//──────────────────────────────────────────────────────────────────────────────

f_findH1TargetLow(float referencePrice) =>
    float targetPrice = na

    int count =
         array.size(h1TargetLows)

    if count > 0
        for index = 0 to count - 1
            float level =
                 array.get(
                      h1TargetLows,
                      index
                 )

            bool alreadySwept =
                 array.get(
                      h1TargetLowSwept,
                      index
                 )

            if not alreadySwept and
               level < referencePrice

                targetPrice :=
                     na(targetPrice)
                     ? level
                     : math.max(
                          targetPrice,
                          level
                     )

    targetPrice

//──────────────────────────────────────────────────────────────────────────────
// Active 15m candle built from 1m candles
//──────────────────────────────────────────────────────────────────────────────

int current15Time =
     time("15")

bool new15mCandle =
     ta.change(current15Time) != 0

bool lastMinuteOf15m =
     time_close == time_close("15")

var int active15Time = na

var float active15High = na
var float active15Low = na
var float active15Close = na

var bool active15Finalized = false

//──────────────────────────────────────────────────────────────────────────────
// Latest opposite 1m candle body levels
//
// Bullish candle:
// body low = open
//
// Bearish candle:
// body high = open
//──────────────────────────────────────────────────────────────────────────────

var float latestBullishBodyLow = na
var int latestBullishTime = na
var int latestBullishBarIndex = na

var float latestBearishBodyHigh = na
var int latestBearishTime = na
var int latestBearishBarIndex = na

//──────────────────────────────────────────────────────────────────────────────
// Pending confirmed 15m sweep
//
// -1 = high sweep, waiting for bearish CISD
// +1 = low sweep, waiting for bullish CISD
//──────────────────────────────────────────────────────────────────────────────

var int pendingDirection = 0

var float pendingSweepPrice = na
var float pendingSweepExtreme = na

var int pendingSweepTime = na
var int pendingSweepCloseTime = na

var float pendingLiquidityTarget = na
var float pendingH1Target = na

var float pendingCisdPrice = na
var int pendingCisdTime = na
var int pendingCisdBarIndex = na

var bool pendingCisdLocked = false
var bool bearishMoveStarted = false
var bool bullishMoveStarted = false

//──────────────────────────────────────────────────────────────────────────────
// Reset pending setup helper logic
//──────────────────────────────────────────────────────────────────────────────

if sessionStarted
    array.clear(completed15Times)
    array.clear(completed15Highs)
    array.clear(completed15Lows)

    array.clear(completed15HighSwept)
    array.clear(completed15LowSwept)

    active15Time := current15Time
    active15High := high
    active15Low := low
    active15Close := close
    active15Finalized := false

    latestBullishBodyLow := na
    latestBullishTime := na
    latestBullishBarIndex := na

    latestBearishBodyHigh := na
    latestBearishTime := na
    latestBearishBarIndex := na

    pendingDirection := 0

    pendingSweepPrice := na
    pendingSweepExtreme := na
    pendingSweepTime := na
    pendingSweepCloseTime := na

    pendingLiquidityTarget := na
    pendingH1Target := na

    pendingCisdPrice := na
    pendingCisdTime := na
    pendingCisdBarIndex := na

    pendingCisdLocked := false
    bearishMoveStarted := false
    bullishMoveStarted := false

//──────────────────────────────────────────────────────────────────────────────
// Start or update current 15m candle
//──────────────────────────────────────────────────────────────────────────────

if isOneMinute and insideSession
    if na(active15Time) or new15mCandle
        active15Time := current15Time
        active15High := high
        active15Low := low
        active15Close := close
        active15Finalized := false

    else
        active15High :=
             math.max(
                  active15High,
                  high
             )

        active15Low :=
             math.min(
                  active15Low,
                  low
             )

        active15Close := close

//──────────────────────────────────────────────────────────────────────────────
// Strong displacement filter
//──────────────────────────────────────────────────────────────────────────────

float candleBody =
     math.abs(close - open)

float candleRange =
     high - low

float averageBody =
     ta.sma(
          math.abs(close - open),
          20
     )

bool strongBearishDisplacement =
     close < open and
     not na(averageBody) and
     candleBody >= averageBody * 1.5 and
     candleRange > 0 and
     candleBody / candleRange >= 0.60

bool strongBullishDisplacement =
     close > open and
     not na(averageBody) and
     candleBody >= averageBody * 1.5 and
     candleRange > 0 and
     candleBody / candleRange >= 0.60

//──────────────────────────────────────────────────────────────────────────────
// Pending bearish CISD
//
// Track the latest bullish candle's body low.
// Lock it once bearish movement starts.
// Confirm when a bearish displacement closes below that body level.
//──────────────────────────────────────────────────────────────────────────────

if isOneMinute and
   insideSession and
   pendingDirection == -1

    // Keep tracking the highest wick throughout
    // the complete sweep-to-CISD sequence.
    pendingSweepExtreme :=
         na(pendingSweepExtreme)
         ? high
         : math.max(
              pendingSweepExtreme,
              high
         )

    if not pendingCisdLocked
        if close > open
            pendingCisdPrice := open
            pendingCisdTime := time
            pendingCisdBarIndex := bar_index

        if close < open and
           not na(pendingCisdTime) and
           time > pendingCisdTime

            bearishMoveStarted := true
            pendingCisdLocked := true

    bool bearishCisd =
         barstate.isconfirmed and
         pendingCisdLocked and
         not na(pendingCisdPrice) and
         not na(pendingCisdTime) and
         not na(pendingCisdBarIndex) and
         not na(pendingSweepExtreme) and
         time > pendingCisdTime and
         close < pendingCisdPrice and
         strongBearishDisplacement

    if bearishCisd
        f_drawSetup(
             pendingSweepTime,
             pendingSweepPrice,
             pendingSweepExtreme,
             pendingCisdBarIndex,
             pendingCisdPrice,
             bar_index,
             close,
             pendingLiquidityTarget,
             pendingH1Target,
             -1
        )

        pendingDirection := 0

        pendingSweepPrice := na
        pendingSweepExtreme := na
        pendingSweepTime := na
        pendingSweepCloseTime := na

        pendingLiquidityTarget := na
        pendingH1Target := na

        pendingCisdPrice := na
        pendingCisdTime := na
        pendingCisdBarIndex := na

        pendingCisdLocked := false
        bearishMoveStarted := false
        bullishMoveStarted := false

//──────────────────────────────────────────────────────────────────────────────
// Pending bullish CISD
//
// Track the latest bearish candle's body high.
// Lock it once bullish movement starts.
// Confirm when bullish displacement closes above that body level.
//──────────────────────────────────────────────────────────────────────────────

if isOneMinute and
   insideSession and
   pendingDirection == 1

    // Keep tracking the lowest wick throughout
    // the complete sweep-to-CISD sequence.
    pendingSweepExtreme :=
         na(pendingSweepExtreme)
         ? low
         : math.min(
              pendingSweepExtreme,
              low
         )

    if not pendingCisdLocked
        if close < open
            pendingCisdPrice := open
            pendingCisdTime := time
            pendingCisdBarIndex := bar_index

        if close > open and
           not na(pendingCisdTime) and
           time > pendingCisdTime

            bullishMoveStarted := true
            pendingCisdLocked := true

    bool bullishCisd =
         barstate.isconfirmed and
         pendingCisdLocked and
         not na(pendingCisdPrice) and
         not na(pendingCisdTime) and
         not na(pendingCisdBarIndex) and
         not na(pendingSweepExtreme) and
         time > pendingCisdTime and
         close > pendingCisdPrice and
         strongBullishDisplacement

    if bullishCisd
        f_drawSetup(
             pendingSweepTime,
             pendingSweepPrice,
             pendingSweepExtreme,
             pendingCisdBarIndex,
             pendingCisdPrice,
             bar_index,
             close,
             pendingLiquidityTarget,
             pendingH1Target,
             1
        )

        pendingDirection := 0

        pendingSweepPrice := na
        pendingSweepExtreme := na
        pendingSweepTime := na
        pendingSweepCloseTime := na

        pendingLiquidityTarget := na
        pendingH1Target := na

        pendingCisdPrice := na
        pendingCisdTime := na
        pendingCisdBarIndex := na

        pendingCisdLocked := false
        bearishMoveStarted := false
        bullishMoveStarted := false

//──────────────────────────────────────────────────────────────────────────────
// Finalize 15m candle and determine sweep
//──────────────────────────────────────────────────────────────────────────────

if isOneMinute and
   insideSession and
   lastMinuteOf15m and
   not active15Finalized

    [sweptHighPrice,sweptHighTime,sweptHighIndex] = f_findSweptHigh(active15High)

    [sweptLowPrice,sweptLowTime,sweptLowIndex] = f_findSweptLow(active15Low)

    bool highSweep =
         not na(sweptHighPrice)

    bool lowSweep =
         not na(sweptLowPrice)

    // Ignore a 15m candle that sweeps both sides.
    bool bearishSweep =
         highSweep and
         not lowSweep

    bool bullishSweep =
         lowSweep and
         not highSweep

    //──────────────────────────────────────────────────────────────────────────
    // High sweep
    //──────────────────────────────────────────────────────────────────────────

    if bearishSweep
        // Find target before storing the current sweep candle.
        float bearishLiquidityTarget =
             f_findTargetLow(close)

        float bearishH1Target =
             f_findH1TargetLow(close)

        array.set(
             completed15HighSwept,
             sweptHighIndex,
             true
        )

        bool sameCandleCisd =
             barstate.isconfirmed and
             not na(latestBullishBodyLow) and
             not na(latestBullishTime) and
             not na(latestBullishBarIndex) and
             time > latestBullishTime and
             close < latestBullishBodyLow and
             strongBearishDisplacement

        if sameCandleCisd
            f_drawSetup(
                 sweptHighTime,
                 sweptHighPrice,
                 active15High,
                 latestBullishBarIndex,
                 latestBullishBodyLow,
                 bar_index,
                 close,
                 bearishLiquidityTarget,
                 bearishH1Target,
                 -1
            )

            pendingDirection := 0

            pendingSweepPrice := na
            pendingSweepExtreme := na
            pendingSweepTime := na
            pendingSweepCloseTime := na

            pendingLiquidityTarget := na
            pendingH1Target := na

            pendingCisdPrice := na
            pendingCisdTime := na
            pendingCisdBarIndex := na

            pendingCisdLocked := false
            bearishMoveStarted := false
            bullishMoveStarted := false

        else
            // Replace an older pending sweep with this immediate new one.
            pendingDirection := -1

            pendingSweepPrice := sweptHighPrice

            // SL is placed above the actual sweep wick.
            pendingSweepExtreme := active15High

            pendingSweepTime := sweptHighTime
            pendingSweepCloseTime := time

            pendingLiquidityTarget :=
                 bearishLiquidityTarget
            pendingH1Target :=
                 bearishH1Target

            pendingCisdLocked := false
            bearishMoveStarted := false
            bullishMoveStarted := false

            if close > open
                // Bullish candle body low.
                pendingCisdPrice := open
                pendingCisdTime := time
                pendingCisdBarIndex := bar_index

            else
                pendingCisdPrice :=
                     latestBullishBodyLow

                pendingCisdTime :=
                     latestBullishTime

                pendingCisdBarIndex :=
                     latestBullishBarIndex

    //──────────────────────────────────────────────────────────────────────────
    // Low sweep
    //──────────────────────────────────────────────────────────────────────────

    if bullishSweep
        // Find target before storing the current sweep candle.
        float bullishLiquidityTarget =
             f_findTargetHigh(close)

        float bullishH1Target =
             f_findH1TargetHigh(close)

        array.set(
             completed15LowSwept,
             sweptLowIndex,
             true
        )

        bool sameCandleCisd =
             barstate.isconfirmed and
             not na(latestBearishBodyHigh) and
             not na(latestBearishTime) and
             not na(latestBearishBarIndex) and
             time > latestBearishTime and
             close > latestBearishBodyHigh and
             strongBullishDisplacement

        if sameCandleCisd
            f_drawSetup(
                 sweptLowTime,
                 sweptLowPrice,
                 active15Low,
                 latestBearishBarIndex,
                 latestBearishBodyHigh,
                 bar_index,
                 close,
                 bullishLiquidityTarget,
                 bullishH1Target,
                 1
            )

            pendingDirection := 0

            pendingSweepPrice := na
            pendingSweepExtreme := na
            pendingSweepTime := na
            pendingSweepCloseTime := na

            pendingLiquidityTarget := na
            pendingH1Target := na

            pendingCisdPrice := na
            pendingCisdTime := na
            pendingCisdBarIndex := na

            pendingCisdLocked := false
            bearishMoveStarted := false
            bullishMoveStarted := false

        else
            pendingDirection := 1

            pendingSweepPrice := sweptLowPrice

            // SL is placed below the actual sweep wick.
            pendingSweepExtreme := active15Low

            pendingSweepTime := sweptLowTime
            pendingSweepCloseTime := time

            pendingLiquidityTarget :=
                 bullishLiquidityTarget
            pendingH1Target :=
                 bullishH1Target

            pendingCisdLocked := false
            bearishMoveStarted := false
            bullishMoveStarted := false

            if close < open
                // Bearish candle body high.
                pendingCisdPrice := open
                pendingCisdTime := time
                pendingCisdBarIndex := bar_index

            else
                pendingCisdPrice :=
                     latestBearishBodyHigh

                pendingCisdTime :=
                     latestBearishTime

                pendingCisdBarIndex :=
                     latestBearishBarIndex

    // Store completed 15m candle after evaluating its sweep and target.
    f_store15m(
         active15Time,
         active15High,
         active15Low
    )

    active15Finalized := true

//──────────────────────────────────────────────────────────────────────────────
// Update latest bullish and bearish candle body references
//──────────────────────────────────────────────────────────────────────────────

if isOneMinute and insideSession
    if close > open
        // Bullish candle body low is its open.
        latestBullishBodyLow := open
        latestBullishTime := time
        latestBullishBarIndex := bar_index

    else if close < open
        // Bearish candle body high is its open.
        latestBearishBodyHigh := open
        latestBearishTime := time
        latestBearishBarIndex := bar_index

//──────────────────────────────────────────────────────────────────────────────
// End-of-session reset
//──────────────────────────────────────────────────────────────────────────────

if sessionEnded
    active15Time := na
    active15High := na
    active15Low := na
    active15Close := na
    active15Finalized := false

    latestBullishBodyLow := na
    latestBullishTime := na
    latestBullishBarIndex := na

    latestBearishBodyHigh := na
    latestBearishTime := na
    latestBearishBarIndex := na

    pendingDirection := 0

    pendingSweepPrice := na
    pendingSweepExtreme := na
    pendingSweepTime := na
    pendingSweepCloseTime := na

    pendingLiquidityTarget := na
    pendingH1Target := na

    pendingCisdPrice := na
    pendingCisdTime := na
    pendingCisdBarIndex := na

    pendingCisdLocked := false
    bearishMoveStarted := false
    bullishMoveStarted := false

//──────────────────────────────────────────────────────────────────────────────
// Timeframe warning
//──────────────────────────────────────────────────────────────────────────────

var table warningTable =
     table.new(
          position.top_right,
          1,
          1
     )

if barstate.islast
    if not isOneMinute
        table.cell(
             warningTable,
             0,
             0,
             "Use on the 1-minute chart",
             text_color = color.white,
             bgcolor = color.red
        )

    else
        table.clear(
             warningTable,
             0,
             0,
             0,
             0
        )