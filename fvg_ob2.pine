//@version=6
indicator(
     "FVG + OB v2 (multi TF)",
     "FVG OB v2",
     overlay = true,
     max_boxes_count = 500,
     max_lines_count = 500
)

// =====================================================================
//  Fair Value Gaps + Order Blocks, on independent timeframes.
//    FVG - 3-candle fair value gap (candle 1's wick doesn't overlap
//          candle 3's wick, leaving an imbalance around candle 2).
//    OB  - order block tied to each FVG; the origin candle is either the
//          first candle of the FVG triple, or a big candle just before it
//          that engulfs that first candle.
//
//  Zones are kept permanently, regardless of whether they are partially
//  or fully filled.
//
//  FVG and OB are detected on each enabled timeframe (via request.security).
//  Volume / Gap Imbalances are detected on the CHART timeframe only, so the
//  higher-timeframe security calls stay lightweight.
// =====================================================================

// ------------------------------ TIMEFRAMES ---------------------------
gTF = "Timeframes"

useCurrentTF = input.bool(
     true,
     "Current Timeframe",
     group = gTF
)

useTF2 = input.bool(
     true,
     "Enable",
     group = gTF,
     inline = "tf2"
)

tf2 = input.timeframe(
     "60",
     "Timeframe 2",
     group = gTF,
     inline = "tf2"
)

useTF3 = input.bool(
     false,
     "Enable",
     group = gTF,
     inline = "tf3"
)

tf3 = input.timeframe(
     "240",
     "Timeframe 3",
     group = gTF,
     inline = "tf3"
)

tf1 = timeframe.period

// ------------------------------ FVG ----------------------------------
gT           = "FVG"
showBull     = input.bool(true,  "Show bullish FVG", group = gT)
showBear     = input.bool(true,  "Show bearish FVG", group = gT)
minSize      = input.float(0.0, "Min gap size (× ATR)", minval = 0, step = 0.05, group = gT, tooltip = "Hide gaps smaller than this multiple of ATR(14) on the selected timeframe. 0 = show all.")

// ------------------------------ ORDER BLOCKS -------------------------
gOB        = "Order Blocks"
showOB     = input.bool(true, "Show order blocks", group = gOB)
obOrigin   = input.string("Nearest qualifying big candle within the lookback", "OB origin candle", options = ["First FVG candle", "Nearest qualifying big candle within the lookback"], group = gOB, tooltip = "Which candle becomes the order block for each FVG. 'First FVG candle' = the first (oldest) candle of the 3-candle FVG. 'Nearest qualifying big candle within the lookback' = the nearest candle within the lookback before that first candle whose range engulfs the first candle's high and low.")
obLookback = input.int(7, "Big-candle lookback", minval = 1, maxval = 50, group = gOB, tooltip = "Only for 'Nearest qualifying big candle within the lookback'. How many candles before the first FVG candle to search for an engulfing big candle.")
obBody     = input.bool(false, "Body only (ignore wicks)", group = gOB)

showLiquidity = input.bool(
     true,
     "Show OB liquidity border",
     group = gOB
)

liquidityBullColor = input.color(
     color.new(#00e676, 0),
     "Liquidity bull / bear",
     group = gOB,
     inline = "liq"
)

liquidityBearColor = input.color(
     color.new(#ff1744, 0),
     "",
     group = gOB,
     inline = "liq"
)

liquidityWidth = input.int(
     2,
     "Liquidity border width",
     minval = 1,
     maxval = 4,
     group = gOB
)

liquidityStyleInput = input.string(
     "Dashed",
     "Liquidity border style",
     options = ["Solid", "Dashed", "Dotted"],
     group = gOB
)

liquidityStyle =
     liquidityStyleInput == "Dashed" ? line.style_dashed :
     liquidityStyleInput == "Dotted" ? line.style_dotted :
     line.style_solid

liquiditySwingStrength = input.int(
     2,
     "Liquidity swing strength",
     minval = 1,
     maxval = 10,
     group = gOB,
     tooltip = "Number of candles required on each side of a swing high/low."
)

liquidityLookback = input.int(
     50,
     "Liquidity search lookback",
     minval = 5,
     maxval = 200,
     group = gOB,
     tooltip = "How far behind the FVG to search for the nearest valid liquidity target."
)

showLiquidityText = input.bool(
     true,
     "Show liquidity timeframe text",
     group = gOB
)

liquidityTextSizeInput = input.string(
     "Tiny",
     "Liquidity text size",
     options = ["Tiny", "Small"],
     group = gOB
)

liquidityTextSize =
     liquidityTextSizeInput == "Small"
         ? size.small
         : size.tiny

sweptLiquidityOpacity = input.int(
     60,
     "Swept liquidity opacity",
     minval = 0,
     maxval = 100,
     group = gOB,
     tooltip = "Transparency applied after liquidity has been swept. 0 = fully visible, 100 = invisible."
)

// ---------------------- ADDITIONAL IMBALANCES ------------------------
// Volume / Gap Imbalances are detected on the chart timeframe only.
gIMB = "Additional Imbalances (chart TF)"

showVI = input.bool(true, "Show Volume Imbalance", group = gIMB)
showGI = input.bool(true, "Show Gap Imbalance", group = gIMB)

maxKeepVI = input.int(
     5,
     "Max Volume Imbalances kept",
     minval = 1,
     maxval = 15,
     group = gIMB,
     tooltip = "Capped so the combined box count across all zone types and timeframes stays within the 500-box pool (max_boxes_count)."
)

maxKeepGI = input.int(
     5,
     "Max Gap Imbalances kept",
     minval = 1,
     maxval = 15,
     group = gIMB
)

cViBull = input.color(
     color.new(#42a5f5, 80),
     "Volume Imbalance bull / bear",
     group = gIMB,
     inline = "vi"
)
cViBear = input.color(
     color.new(#ab47bc, 80),
     "",
     group = gIMB,
     inline = "vi"
)

cGiBull = input.color(
     color.new(#ffa726, 80),
     "Gap Imbalance bull / bear",
     group = gIMB,
     inline = "gi"
)
cGiBear = input.color(
     color.new(#78909c, 80),
     "",
     group = gIMB,
     inline = "gi"
)

// ------------------------------ STYLE & KEEPS ------------------------
gS            = "Style & Limits"
cBull         = input.color(color.new(#26a69a, 80), "Bullish FVG fill / border", group = gS, inline = "bu")
cBullB        = input.color(color.rgb(38, 166, 154), "", group = gS, inline = "bu")
cBear         = input.color(color.new(#ef5350, 80), "Bearish FVG fill / border", group = gS, inline = "be")
cBearB        = input.color(color.rgb(239, 83, 80), "", group = gS, inline = "be")
cObBull       = input.color(color.new(#2e7d32, 80), "OB bull / bear", group = gS, inline = "ob")
cObBear       = input.color(color.new(#8e0000, 80), "", group = gS, inline = "ob")
cObBullB      = input.color(color.rgb(46, 125, 50), "", group = gS, inline = "ob")
cObBearB      = input.color(color.rgb(142, 0, 0), "", group = gS, inline = "ob")

filledZoneOpacity = input.int(
     95,
     "Filled FVG + OB opacity",
     minval = 0,
     maxval = 100,
     group = gS,
     tooltip = "Transparency applied to both the FVG and OB after price fully trades through the OB. 0 = fully visible, 100 = invisible."
)
showBorder    = input.bool(false, "Show border", group = gS)
showLabelsCurrent = input.bool(false, "Show FVG + OB labels (Current TF)", group = gS)
showLabelsOther   = input.bool(true, "Show FVG + OB labels (Other TFs)", group = gS)
extBars       = input.int(10, "Extend right (bars)", minval = 0, group = gS)
maxKeepBull   = input.int(5, "Max bullish zones kept", minval = 1, maxval = 15, group = gS, tooltip = "Per timeframe. Each kept zone draws up to 2 boxes (FVG + OB). Capped so the combined box count across all zone types and timeframes stays within the 500-box pool (max_boxes_count).")
maxKeepBear   = input.int(5, "Max bearish zones kept", minval = 1, maxval = 15, group = gS)
firstLastBull = input.bool(true, "Show first & last only (Bullish)", group = gS)
firstLastBear = input.bool(true, "Show first & last only (Bearish)", group = gS)
showDebug     = input.bool(false, "Show debug info", group = gS, tooltip = "Enable to show a label on the last bar with array sizes and group keys.")

obFirst = obOrigin == "First FVG candle"
chartMs = timeframe.in_seconds() * 1000

// Right-extension measured in each zone's OWN timeframe bars (not chart bars),
// so "Extend right (bars)" looks consistent across timeframes.
extMs1 = chartMs
extMs2 = timeframe.in_seconds(tf2) * 1000
extMs3 = timeframe.in_seconds(tf3) * 1000

// ------------------------------ STATE --------------------------------
var array<box>  fB    = array.new<box>()
var array<bool> fBull = array.new<bool>()
var array<int>  fGrp  = array.new<int>()
var array<int>  fSlot = array.new<int>()

var array<box>  oB    = array.new<box>()
var array<bool> oBull = array.new<bool>()
var array<int>  oGrp  = array.new<int>()
var array<int>  oSlot = array.new<int>()
var array<int>  oMade   = array.new<int>()
var array<bool> oFilled = array.new<bool>()
var array<line> oLiquidity = array.new<line>()
var array<label> oLiquidityLabel = array.new<label>()
var array<float> oLiquidityPrice = array.new<float>()
var array<bool>  oLiquiditySwept = array.new<bool>()
var array<bool>  oTouched = array.new<bool>()

// Volume Imbalance state
var array<box>  viB    = array.new<box>()
var array<bool> viBull = array.new<bool>()
var array<int>  viTime = array.new<int>()
var array<int>  viSlot = array.new<int>()

// Gap Imbalance state
var array<box>  giB    = array.new<box>()
var array<bool> giBull = array.new<bool>()
var array<int>  giTime = array.new<int>()
var array<int>  giSlot = array.new<int>()

// ------------------------------ DETECTION ----------------------------
detectZones(
     float mSz,
     bool obF,
     int obL,
     bool obBdy,
     int liqStrength,
     int liqLookback
) =>
    atr  = ta.atr(14)
    
    // FVG detection
    bullFVG = low > high[2] and (low - high[2]) > mSz * atr
    bearFVG = high < low[2] and (low[2] - high) > mSz * atr
    
    float buT = bullFVG ? low     : na    // bull top
    float buB = bullFVG ? high[2] : na    // bull bottom
    int   buX = bullFVG ? time[1] : na    // anchor = middle candle
    float beT = bearFVG ? low[2]  : na    // bear top
    float beB = bearFVG ? high    : na    // bear bottom
    int   beX = bearFVG ? time[1] : na
    
    // ---- order block origin candle (bars back from current) ----
    int obIdx = na
    if bullFVG or bearFVG
        if obF
            obIdx := 2                    // first candle of the FVG triple
        else
            // Default OB origin: first FVG candle.
            obIdx := 2

            for distance = 1 to obL
                candidateIdx = 2 + distance

                firstHigh = high[2]
                firstLow  = low[2]

                candidateHigh = high[candidateIdx]
                candidateLow  = low[candidateIdx]

                // Candidate fully contains the first FVG candle.
                candidateEngulfs =
                     candidateHigh >= firstHigh and
                     candidateLow <= firstLow

                // Candidate crosses only one side of the first FVG candle.
                candidateBreaksRange =
                     candidateHigh > firstHigh or
                     candidateLow < firstLow

                if candidateEngulfs
                    // Nearest valid big candle found.
                    obIdx := candidateIdx
                    break
                else if candidateBreaksRange
                    // The range was already broken before finding an engulfing
                    // candle, so keep the first FVG candle as the OB.
                    obIdx := 2
                    break
    float obT = na
    float obB = na
    int   obX = na
    if not na(obIdx)
        obT := obBdy ? math.max(open[obIdx], close[obIdx]) : high[obIdx]
        obB := obBdy ? math.min(open[obIdx], close[obIdx]) : low[obIdx]
        obX := time[obIdx]
    float obBuT = bullFVG ? obT : na
    float obBuB = bullFVG ? obB : na
    int   obBuX = bullFVG ? obX : na
    float obBeT = bearFVG ? obT : na
    float obBeB = bearFVG ? obB : na
    int   obBeX = bearFVG ? obX : na

    // ---------------------------------------------------------
    // External unswept liquidity target
    // Bullish OB -> nearest unswept swing high above the OB.
    // Bearish OB -> nearest unswept swing low below the OB.
    // ---------------------------------------------------------
    float bullLiquidity = na
    float bearLiquidity = na

    if bullFVG and not na(obT)
        for candidateIdx = liqStrength + 1 to liqLookback
            bool isSwingHigh = true

            // Confirm pivot structure.
            for offset = 1 to liqStrength
                if high[candidateIdx] <= high[candidateIdx - offset] or
                     high[candidateIdx] <= high[candidateIdx + offset]
                    isSwingHigh := false
                    break

            // Confirm the swing has not already been swept
            // between its formation and the current FVG.
            bool remainsUnswept = true

            if isSwingHigh
                for newerIdx = 0 to candidateIdx - 1
                    if high[newerIdx] >= high[candidateIdx]
                        remainsUnswept := false
                        break

            if isSwingHigh and
                 remainsUnswept and
                 high[candidateIdx] > obT
                bullLiquidity := high[candidateIdx]
                break

    if bearFVG and not na(obB)
        for candidateIdx = liqStrength + 1 to liqLookback
            bool isSwingLow = true

            // Confirm pivot structure.
            for offset = 1 to liqStrength
                if low[candidateIdx] >= low[candidateIdx - offset] or
                     low[candidateIdx] >= low[candidateIdx + offset]
                    isSwingLow := false
                    break

            // Confirm the swing has not already been swept
            // between its formation and the current FVG.
            bool remainsUnswept = true

            if isSwingLow
                for newerIdx = 0 to candidateIdx - 1
                    if low[newerIdx] <= low[candidateIdx]
                        remainsUnswept := false
                        break

            if isSwingLow and
                 remainsUnswept and
                 low[candidateIdx] < obB
                bearLiquidity := low[candidateIdx]
                break

    [buT, buB, buX, beT, beB, beX, obBuT, obBuB, obBuX, obBeT, obBeB, obBeX, bullLiquidity, bearLiquidity]

[buT1, buB1, buX1, beT1, beB1, beX1, obBuT1, obBuB1, obBuX1, obBeT1, obBeB1, obBeX1, bullLiq1, bearLiq1] = detectZones(minSize, obFirst, obLookback, obBody, liquiditySwingStrength, liquidityLookback)
[buT2, buB2, buX2, beT2, beB2, beX2, obBuT2, obBuB2, obBuX2, obBeT2, obBeB2, obBeX2, bullLiq2, bearLiq2] = request.security(syminfo.tickerid, useTF2 ? tf2 : timeframe.period, detectZones(minSize, obFirst, obLookback, obBody, liquiditySwingStrength, liquidityLookback), lookahead = barmerge.lookahead_off)
[buT3, buB3, buX3, beT3, beB3, beX3, obBuT3, obBuB3, obBuX3, obBeT3, obBeB3, obBeX3, bullLiq3, bearLiq3] = request.security(syminfo.tickerid, useTF3 ? tf3 : timeframe.period, detectZones(minSize, obFirst, obLookback, obBody, liquiditySwingStrength, liquidityLookback), lookahead = barmerge.lookahead_off)

// ------------------------------ HELPERS ------------------------------
rightTForSlot(int slot) =>
    ms = slot == 1 ? extMs1 :
         slot == 2 ? extMs2 :
         slot == 3 ? extMs3 : chartMs
    time + (extBars + 1) * ms

// Helper to check if an array includes a value
array_includes(array<int> arr, int val) =>
    bool found = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            if array.get(arr, i) == val
                found := true
                break
    found

makeGroup(int anchorTime, int slot) =>
    anchorTime + slot

tfLabel(string tf) =>
    sec = timeframe.in_seconds(tf)
    sec >= 2592000 ? str.tostring(int(math.round(sec / 2592000.0))) + "M" :
         sec >= 604800 ? str.tostring(int(math.round(sec / 604800.0))) + "W" :
         sec >= 86400 ? str.tostring(int(math.round(sec / 86400.0))) + "D" :
         sec >= 3600 ? str.tostring(int(math.round(sec / 3600.0))) + "H" :
         str.tostring(int(math.round(sec / 60.0))) + "m"

slotTF(int slot) =>
    slot == 1 ? timeframe.period :
     slot == 2 ? tf2 :
     slot == 3 ? tf3 : ""

setWatermark(box b, string txt, color textColor, int slot) =>
    showLabelsForThisSlot = (slot == 1) ? showLabelsCurrent : showLabelsOther
    box.set_text(b, showLabelsForThisSlot ? txt : "")
    box.set_text_size(b, size.tiny)
    box.set_text_formatting(b, text.format_bold)
    box.set_text_color(b, color.new(textColor, 25))
    box.set_text_halign(b, text.align_right)
    box.set_text_valign(b, text.align_center)

setGapWatermark(box b, string txt, color textColor) =>
    box.set_text(b, txt)
    box.set_text_size(b, size.tiny)
    box.set_text_formatting(b, text.format_bold)
    box.set_text_color(b, color.new(textColor, 25))
    box.set_text_halign(b, text.align_right)
    box.set_text_valign(b, text.align_top)

showBox(
     box b,
     bool visible,
     color bg,
     color bcol,
     string watermark,
     bool showLabelsForThisSlot
) =>
    box.set_bgcolor(b, visible ? bg : color(na))
    box.set_border_color(
         b,
         visible and showBorder ? bcol : color(na)
    )

    box.set_text(b, visible and showLabelsForThisSlot ? watermark : "")

    if visible and showLabelsForThisSlot
        box.set_text_size(b, size.tiny)
        box.set_text_formatting(b, text.format_bold)
        box.set_text_color(b, color.new(bcol, 25))
        box.set_text_halign(b, text.align_right)
        box.set_text_valign(b, text.align_center)

hasGapForSlot(
     array<int> times,
     array<int> slots,
     int gapTime,
     int slot
) =>
    bool found = false

    if array.size(times) > 0
        for i = 0 to array.size(times) - 1
            if array.get(times, i) == gapTime and
                 array.get(slots, i) == slot
                found := true
                break

    found

isZoneFilled(int grp, int slot) =>
    bool result = false

    if array.size(oGrp) > 0
        for i = 0 to array.size(oGrp) - 1
            if array.get(oGrp, i) == grp and
                 array.get(oSlot, i) == slot and
                 array.get(oFilled, i)
                result := true
                break

    result

addFVG(
     float top,
     float bot,
     int leftT,
     bool isBull,
     int grp,
     int slot,
     string tfText
) =>
    bcol = isBull ? cBullB : cBearB

    b = box.new(
         leftT,
         top,
         rightTForSlot(slot),
         bot,
         xloc = xloc.bar_time,
         border_width = showBorder ? 1 : 0,
         border_color = showBorder ? bcol : color(na),
         bgcolor = isBull ? cBull : cBear
    )

    setWatermark(b, tfText + " FVG", bcol, slot)

    array.push(fB, b)
    array.push(fBull, isBull)
    array.push(fGrp, grp)
    array.push(fSlot, slot)

addOB(
     float top,
     float bot,
     int leftT,
     bool isBull,
     int grp,
     int slot,
     string tfText,
     float liquidityPrice
) =>
    bcol = isBull ? cObBullB : cObBearB

    b = box.new(
         leftT,
         top,
         rightTForSlot(slot),
         bot,
         xloc = xloc.bar_time,
         border_width = showBorder ? 1 : 0,
         border_color = showBorder ? bcol : color(na),
         bgcolor = isBull ? cObBull : cObBear
    )

    setWatermark(b, tfText + " OB", bcol, slot)

    liquidityColor = isBull
         ? liquidityBullColor
         : liquidityBearColor

    liquidityLine = line.new(
         leftT,
         na(liquidityPrice) ? top : liquidityPrice,
         rightTForSlot(slot),
         na(liquidityPrice) ? top : liquidityPrice,
         xloc = xloc.bar_time,
         extend = extend.none,
         color = showLiquidity and not na(liquidityPrice)
              ? liquidityColor
              : color(na),
         style = liquidityStyle,
         width = liquidityWidth
    )

    liquidityLabel = label.new(
         rightTForSlot(slot),
         na(liquidityPrice) ? top : liquidityPrice,
         tfText + " Liquidity",
         xloc = xloc.bar_time,
         style = label.style_label_left,
         color = color.new(color.black, 100),
         textcolor = showLiquidity and
              showLiquidityText and
              not na(liquidityPrice)
                  ? liquidityColor
                  : color(na),
         size = liquidityTextSize
    )

    array.push(oB, b)
    array.push(oBull, isBull)
    array.push(oGrp, grp)
    array.push(oSlot, slot)
    array.push(oMade, time)
    array.push(oFilled, false)
    array.push(oLiquidity, liquidityLine)
    array.push(oLiquidityLabel, liquidityLabel)
    array.push(oLiquidityPrice, liquidityPrice)
    array.push(oLiquiditySwept, false)
    array.push(oTouched, false)

addVI(
     float top,
     float bot,
     int leftT,
     bool isBull,
     int slot,
     string tfText
) =>
    bg = isBull ? cViBull : cViBear

    b = box.new(
         leftT,
         top,
         rightTForSlot(slot),
         bot,
         xloc = xloc.bar_time,
         border_width = 0,
         bgcolor = bg
    )

    setGapWatermark(
         b,
         tfText + " VI",
         color.new(bg, 0)
    )

    array.push(viB, b)
    array.push(viBull, isBull)
    array.push(viTime, leftT)
    array.push(viSlot, slot)

addGI(
     float top,
     float bot,
     int leftT,
     bool isBull,
     int slot,
     string tfText
) =>
    bg = isBull ? cGiBull : cGiBear

    b = box.new(
         leftT,
         top,
         rightTForSlot(slot),
         bot,
         xloc = xloc.bar_time,
         border_width = 0,
         bgcolor = bg
    )

    setGapWatermark(
         b,
         tfText + " GI",
         color.new(bg, 0)
    )

    array.push(giB, b)
    array.push(giBull, isBull)
    array.push(giTime, leftT)
    array.push(giSlot, slot)

// ------------------------------ PROCESS TF ---------------------------
processTF(
     bool enabled,
     int slot,
     string tf,
     float buTop,
     float buBot,
     int buAnchor,
     float beTop,
     float beBot,
     int beAnchor,
     float bullObTop,
     float bullObBot,
     int bullObTime,
     float bearObTop,
     float bearObBot,
     int bearObTime,
     float bullLiquidity,
     float bearLiquidity
) =>
    label = tfLabel(tf)

    bullGrp = not na(buAnchor) ? makeGroup(buAnchor, slot) : na
    bearGrp = not na(beAnchor) ? makeGroup(beAnchor, slot) : na

    if enabled
        if showBull and not na(buAnchor) and not array_includes(fGrp, bullGrp)
            addFVG(
                 buTop,
                 buBot,
                 buAnchor,
                 true,
                 bullGrp,
                 slot,
                 label
            )

        if showBear and not na(beAnchor) and not array_includes(fGrp, bearGrp)
            addFVG(
                 beTop,
                 beBot,
                 beAnchor,
                 false,
                 bearGrp,
                 slot,
                 label
            )

        if showOB and showBull and not na(bullObTime) and
             not na(bullGrp) and not array_includes(oGrp, bullGrp)
            addOB(
                 bullObTop,
                 bullObBot,
                 bullObTime,
                 true,
                 bullGrp,
                 slot,
                 label,
                 bullLiquidity
            )

        if showOB and showBear and not na(bearObTime) and
             not na(bearGrp) and not array_includes(oGrp, bearGrp)
            addOB(
                 bearObTop,
                 bearObBot,
                 bearObTime,
                 false,
                 bearGrp,
                 slot,
                 label,
                 bearLiquidity
            )

// Current/chart timeframe pivots
newSwingHigh1 = ta.pivothigh(
     high,
     liquiditySwingStrength,
     liquiditySwingStrength
)

newSwingLow1 = ta.pivotlow(
     low,
     liquiditySwingStrength,
     liquiditySwingStrength
)

// Timeframe 2 pivots
[newSwingHigh2, newSwingLow2] = request.security(
     syminfo.tickerid,
     tf2,
     [
         ta.pivothigh(
              high,
              liquiditySwingStrength,
              liquiditySwingStrength
         ),
         ta.pivotlow(
              low,
              liquiditySwingStrength,
              liquiditySwingStrength
         )
     ],
     lookahead = barmerge.lookahead_off
)

// Timeframe 3 pivots
[newSwingHigh3, newSwingLow3] = request.security(
     syminfo.tickerid,
     tf3,
     [
         ta.pivothigh(
              high,
              liquiditySwingStrength,
              liquiditySwingStrength
         ),
         ta.pivotlow(
              low,
              liquiditySwingStrength,
              liquiditySwingStrength
         )
     ],
     lookahead = barmerge.lookahead_off
)

// ------------------------------ EXECUTION ----------------------------
if barstate.isconfirmed
    processTF(
         useCurrentTF,
         1,
         timeframe.period,
         buT1, buB1, buX1,
         beT1, beB1, beX1,
         obBuT1, obBuB1, obBuX1,
         obBeT1, obBeB1, obBeX1,
         bullLiq1,
         bearLiq1
    )

    processTF(
         useTF2,
         2,
         tf2,
         buT2, buB2, buX2,
         beT2, beB2, beX2,
         obBuT2, obBuB2, obBuX2,
         obBeT2, obBeB2, obBeX2,
         bullLiq2,
         bearLiq2
    )

    processTF(
         useTF3,
         3,
         tf3,
         buT3, buB3, buX3,
         beT3, beB3, beX3,
         obBuT3, obBuB3, obBuX3,
         obBeT3, obBeB3, obBeX3,
         bullLiq3,
         bearLiq3
    )

    // ---- Volume / Gap Imbalances on the CHART timeframe (no security) ----
    // Slot 0 marks chart-timeframe gaps; rightTForSlot(0) extends by chart bars.
    chartLabel = tfLabel(timeframe.period)

    if showVI
        prevBodyTop = math.max(open[1], close[1])
        prevBodyBot = math.min(open[1], close[1])
        currBodyTop = math.max(open, close)
        currBodyBot = math.min(open, close)
        wicksOverlap = low <= high[1] and high >= low[1]
        bullVI = currBodyBot > prevBodyTop and wicksOverlap
        bearVI = currBodyTop < prevBodyBot and wicksOverlap

        if bullVI and not hasGapForSlot(viTime, viSlot, time[1], 0)
            addVI(currBodyBot, prevBodyTop, time[1], true, 0, chartLabel)
        if bearVI and not hasGapForSlot(viTime, viSlot, time[1], 0)
            addVI(prevBodyBot, currBodyTop, time[1], false, 0, chartLabel)

    if showGI
        bullGI = low > high[1]
        bearGI = high < low[1]

        if bullGI and not hasGapForSlot(giTime, giSlot, time[1], 0)
            addGI(low, high[1], time[1], true, 0, chartLabel)
        if bearGI and not hasGapForSlot(giTime, giSlot, time[1], 0)
            addGI(low[1], high, time[1], false, 0, chartLabel)

    // ---- Unified pruning by group key (per timeframe slot and type) ----
    for s = 1 to 3
        uniqueGrpsBull = array.new<int>()
        uniqueGrpsBear = array.new<int>()
        
        // Collect unique group keys for slot `s`
        if array.size(fGrp) > 0
            for idx = 0 to array.size(fGrp) - 1
                g = array.get(fGrp, idx)
                slot = array.get(fSlot, idx)
                isBull = array.get(fBull, idx)
                if slot == s
                    if isBull
                        if not array_includes(uniqueGrpsBull, g)
                            array.push(uniqueGrpsBull, g)
                    else
                        if not array_includes(uniqueGrpsBear, g)
                            array.push(uniqueGrpsBear, g)
                            
        if array.size(oGrp) > 0
            for idx = 0 to array.size(oGrp) - 1
                g = array.get(oGrp, idx)
                slot = array.get(oSlot, idx)
                isBull = array.get(oBull, idx)
                if slot == s
                    if isBull
                        if not array_includes(uniqueGrpsBull, g)
                            array.push(uniqueGrpsBull, g)
                    else
                        if not array_includes(uniqueGrpsBear, g)
                            array.push(uniqueGrpsBear, g)
        
        array.sort(uniqueGrpsBull)
        array.sort(uniqueGrpsBear)
        
        // Prune oldest bullish zones for slot `s`
        if array.size(uniqueGrpsBull) > maxKeepBull
            excess = array.size(uniqueGrpsBull) - maxKeepBull
            for e = 0 to excess - 1
                gToRemove = array.get(uniqueGrpsBull, e)
                
                // Delete and remove matching FVG boxes
                if array.size(fGrp) > 0
                    idx = array.size(fGrp) - 1
                    while idx >= 0
                        if array.get(fGrp, idx) == gToRemove and array.get(fSlot, idx) == s
                            box.delete(array.get(fB, idx))
                            array.remove(fB, idx)
                            array.remove(fBull, idx)
                            array.remove(fGrp, idx)
                            array.remove(fSlot, idx)
                        idx -= 1
                
                // Delete and remove matching OB boxes
                if array.size(oGrp) > 0
                    idx = array.size(oGrp) - 1
                    while idx >= 0
                        if array.get(oGrp, idx) == gToRemove and array.get(oSlot, idx) == s
                            box.delete(array.get(oB, idx))
                            line.delete(array.get(oLiquidity, idx))
                            label.delete(array.get(oLiquidityLabel, idx))
                            array.remove(oB, idx)
                            array.remove(oBull, idx)
                            array.remove(oGrp, idx)
                            array.remove(oSlot, idx)
                            array.remove(oMade, idx)
                            array.remove(oFilled, idx)
                            array.remove(oLiquidity, idx)
                            array.remove(oLiquidityLabel, idx)
                            array.remove(oLiquidityPrice, idx)
                            array.remove(oLiquiditySwept, idx)
                            array.remove(oTouched, idx)
                        idx -= 1

        // Prune oldest bearish zones for slot `s`
        if array.size(uniqueGrpsBear) > maxKeepBear
            excess = array.size(uniqueGrpsBear) - maxKeepBear
            for e = 0 to excess - 1
                gToRemove = array.get(uniqueGrpsBear, e)
                
                // Delete and remove matching FVG boxes
                if array.size(fGrp) > 0
                    idx = array.size(fGrp) - 1
                    while idx >= 0
                        if array.get(fGrp, idx) == gToRemove and array.get(fSlot, idx) == s
                            box.delete(array.get(fB, idx))
                            array.remove(fB, idx)
                            array.remove(fBull, idx)
                            array.remove(fGrp, idx)
                            array.remove(fSlot, idx)
                        idx -= 1
                
                // Delete and remove matching OB boxes
                if array.size(oGrp) > 0
                    idx = array.size(oGrp) - 1
                    while idx >= 0
                        if array.get(oGrp, idx) == gToRemove and array.get(oSlot, idx) == s
                            box.delete(array.get(oB, idx))
                            line.delete(array.get(oLiquidity, idx))
                            label.delete(array.get(oLiquidityLabel, idx))
                            array.remove(oB, idx)
                            array.remove(oBull, idx)
                            array.remove(oGrp, idx)
                            array.remove(oSlot, idx)
                            array.remove(oMade, idx)
                            array.remove(oFilled, idx)
                            array.remove(oLiquidity, idx)
                            array.remove(oLiquidityLabel, idx)
                            array.remove(oLiquidityPrice, idx)
                            array.remove(oLiquiditySwept, idx)
                            array.remove(oTouched, idx)
                        idx -= 1

    // ---- Pruning for chart Volume / Gap Imbalances (oldest first) ----
    while array.size(viB) > maxKeepVI
        box.delete(array.get(viB, 0))
        array.remove(viB, 0)
        array.remove(viBull, 0)
        array.remove(viTime, 0)
        array.remove(viSlot, 0)

    while array.size(giB) > maxKeepGI
        box.delete(array.get(giB, 0))
        array.remove(giB, 0)
        array.remove(giBull, 0)
        array.remove(giTime, 0)
        array.remove(giSlot, 0)

// ----------------------- EXTEND --------------------------------------
if array.size(fB) > 0
    for i = 0 to array.size(fB) - 1
        bx = array.get(fB, i)
        box.set_right(bx, rightTForSlot(array.get(fSlot, i)))

if array.size(oB) > 0
    for i = 0 to array.size(oB) - 1
        bx = array.get(oB, i)
        box.set_right(bx, rightTForSlot(array.get(oSlot, i)))

if array.size(oLiquidity) > 0
    for i = 0 to array.size(oLiquidity) - 1
        li     = array.get(oLiquidity, i)
        lbl    = array.get(oLiquidityLabel, i)
        slot   = array.get(oSlot, i)
        rightX = rightTForSlot(slot)

        line.set_x2(li, rightX)
        label.set_x(lbl, rightX)

if array.size(viB) > 0
    for i = 0 to array.size(viB) - 1
        bx = array.get(viB, i)
        box.set_right(bx, rightTForSlot(array.get(viSlot, i)))

if array.size(giB) > 0
    for i = 0 to array.size(giB) - 1
        bx = array.get(giB, i)
        box.set_right(bx, rightTForSlot(array.get(giSlot, i)))

// ----------------------- OB FILL STATUS ------------------------------
if array.size(oB) > 0
    for idx = 0 to array.size(oB) - 1
        if not array.get(oFilled, idx)
            bx   = array.get(oB, idx)
            bull = array.get(oBull, idx)
            made = array.get(oMade, idx)

            top = box.get_top(bx)
            bot = box.get_bottom(bx)

            completelyFilled =
                 time > made and
                 (bull ? low <= bot : high >= top)

            if completelyFilled
                array.set(oFilled, idx, true)

// -------------------- OB TOUCH + LIQUIDITY STATUS -------------------
if array.size(oB) > 0
    for idx = 0 to array.size(oB) - 1
        bx       = array.get(oB, idx)
        bull     = array.get(oBull, idx)
        made     = array.get(oMade, idx)
        top      = box.get_top(bx)
        bot      = box.get_bottom(bx)
        touched  = array.get(oTouched, idx)
        liqPrice = array.get(oLiquidityPrice, idx)

        // Price has entered the OB range.
        obTapped =
             time > made and
             high >= bot and
             low <= top

        if not touched and obTapped
            array.set(oTouched, idx, true)
            touched := true

        slot = array.get(oSlot, idx)

        slotSwingHigh =
             slot == 1 ? newSwingHigh1 :
             slot == 2 ? newSwingHigh2 :
             slot == 3 ? newSwingHigh3 :
             na

        slotSwingLow =
             slot == 1 ? newSwingLow1 :
             slot == 2 ? newSwingLow2 :
             slot == 3 ? newSwingLow3 :
             na

        if not touched
            liquidityLine  = array.get(oLiquidity, idx)
            liquidityLabel = array.get(oLiquidityLabel, idx)

            // Bullish OB:
            // Use only a swing high from the OB's own timeframe.
            // It must also be above the OB.
            validBullLiquidity =
                 bull and
                 not na(slotSwingHigh) and
                 slotSwingHigh > top

            if validBullLiquidity
                closerBullTarget =
                     na(liqPrice) or
                     slotSwingHigh < liqPrice

                if closerBullTarget
                    liqPrice := slotSwingHigh

                    array.set(
                         oLiquidityPrice,
                         idx,
                         liqPrice
                    )

                    line.set_y1(
                         liquidityLine,
                         liqPrice
                    )

                    line.set_y2(
                         liquidityLine,
                         liqPrice
                    )

                    label.set_y(
                         liquidityLabel,
                         liqPrice
                    )

            // Bearish OB:
            // Use only a swing low from the OB's own timeframe.
            // It must also be below the OB.
            validBearLiquidity =
                 not bull and
                 not na(slotSwingLow) and
                 slotSwingLow < bot

            if validBearLiquidity
                closerBearTarget =
                     na(liqPrice) or
                     slotSwingLow > liqPrice

                if closerBearTarget
                    liqPrice := slotSwingLow

                    array.set(
                         oLiquidityPrice,
                         idx,
                         liqPrice
                    )

                    line.set_y1(
                         liquidityLine,
                         liqPrice
                    )

                    line.set_y2(
                         liquidityLine,
                         liqPrice
                    )

                    label.set_y(
                         liquidityLabel,
                         liqPrice
                    )

        // Target liquidity is only counted as swept after
        // price has first returned to the OB.
        if touched and
             not array.get(oLiquiditySwept, idx) and
             not na(liqPrice)

            liquiditySwept =
                 bull
                     ? high >= liqPrice
                     : low <= liqPrice

            if liquiditySwept
                array.set(oLiquiditySwept, idx, true)

// ----------------------- SHOW FIRST & LAST ONLY ---------------------
// Reset and calculate min/max group keys per timeframe slot and type.
var array<int> gMinBull = array.new<int>(4, na)
var array<int> gMaxBull = array.new<int>(4, na)
var array<int> gMinBear = array.new<int>(4, na)
var array<int> gMaxBear = array.new<int>(4, na)

array.fill(gMinBull, na)
array.fill(gMaxBull, na)
array.fill(gMinBear, na)
array.fill(gMaxBear, na)

if array.size(fGrp) > 0
    for idx = 0 to array.size(fGrp) - 1
        g = array.get(fGrp, idx)
        slot = array.get(fSlot, idx)
        isBull = array.get(fBull, idx)
        if isBull
            minVal = array.get(gMinBull, slot)
            maxVal = array.get(gMaxBull, slot)
            array.set(gMinBull, slot, na(minVal) or g < minVal ? g : minVal)
            array.set(gMaxBull, slot, na(maxVal) or g > maxVal ? g : maxVal)
        else
            minVal = array.get(gMinBear, slot)
            maxVal = array.get(gMaxBear, slot)
            array.set(gMinBear, slot, na(minVal) or g < minVal ? g : minVal)
            array.set(gMaxBear, slot, na(maxVal) or g > maxVal ? g : maxVal)

if array.size(oGrp) > 0
    for idx = 0 to array.size(oGrp) - 1
        g = array.get(oGrp, idx)
        slot = array.get(oSlot, idx)
        isBull = array.get(oBull, idx)
        if isBull
            minVal = array.get(gMinBull, slot)
            maxVal = array.get(gMaxBull, slot)
            array.set(gMinBull, slot, na(minVal) or g < minVal ? g : minVal)
            array.set(gMaxBull, slot, na(maxVal) or g > maxVal ? g : maxVal)
        else
            minVal = array.get(gMinBear, slot)
            maxVal = array.get(gMaxBear, slot)
            array.set(gMinBear, slot, na(minVal) or g < minVal ? g : minVal)
            array.set(gMaxBear, slot, na(maxVal) or g > maxVal ? g : maxVal)

if array.size(fB) > 0
    for idx = 0 to array.size(fB) - 1
        g    = array.get(fGrp, idx)
        slot = array.get(fSlot, idx)
        bull = array.get(fBull, idx)

        zoneFilled = isZoneFilled(g, slot)

        baseBg   = bull ? cBull : cBear
        baseBcol = bull ? cBullB : cBearB

        bg =
             zoneFilled
                 ? color.new(baseBg, filledZoneOpacity)
                 : baseBg

        bcol =
             zoneFilled
                 ? color.new(baseBcol, filledZoneOpacity)
                 : baseBcol

        minVal =
             bull
                 ? array.get(gMinBull, slot)
                 : array.get(gMinBear, slot)

        maxVal =
             bull
                 ? array.get(gMaxBull, slot)
                 : array.get(gMaxBear, slot)

        firstLast = bull ? firstLastBull : firstLastBear
        visible = not firstLast or (g == minVal or g == maxVal)
        tfText = tfLabel(slotTF(slot))

        showLabelsForThisSlot = (slot == 1) ? showLabelsCurrent : showLabelsOther
        showBox(
             array.get(fB, idx),
             visible,
             bg,
             bcol,
             tfText + " FVG",
             showLabelsForThisSlot
        )

if array.size(oB) > 0
    for idx = 0 to array.size(oB) - 1
        g      = array.get(oGrp, idx)
        slot   = array.get(oSlot, idx)
        bull   = array.get(oBull, idx)
        filled = array.get(oFilled, idx)

        zoneFilled = isZoneFilled(g, slot)

        baseBg   = bull ? cObBull : cObBear
        baseBcol = bull ? cObBullB : cObBearB

        bg =
             zoneFilled
                 ? color.new(baseBg, filledZoneOpacity)
                 : baseBg

        bcol =
             zoneFilled
                 ? color.new(baseBcol, filledZoneOpacity)
                 : baseBcol

        minVal =
             bull
                 ? array.get(gMinBull, slot)
                 : array.get(gMinBear, slot)

        maxVal =
             bull
                 ? array.get(gMaxBull, slot)
                 : array.get(gMaxBear, slot)

        firstLast = bull ? firstLastBull : firstLastBear
        visible = not firstLast or (g == minVal or g == maxVal)
        tfText = tfLabel(slotTF(slot))
        liquidityLine  = array.get(oLiquidity, idx)
        liquidityLabel = array.get(oLiquidityLabel, idx)
        liquidityColor = bull ? liquidityBullColor : liquidityBearColor
        liquiditySwept = array.get(oLiquiditySwept, idx)
        liquidityPrice = array.get(oLiquidityPrice, idx)

        showThisLiquidity =
             visible and
             showLiquidity and
             not na(liquidityPrice)

        displayLiquidityColor =
             liquiditySwept
                 ? color.new(liquidityColor, sweptLiquidityOpacity)
                 : liquidityColor

        line.set_color(
             liquidityLine,
             showThisLiquidity
                 ? displayLiquidityColor
                 : color(na)
        )

        label.set_text(
             liquidityLabel,
             liquiditySwept
                 ? tfText + " Liquidity ✓"
                 : tfText + " Liquidity"
            )

        label.set_textcolor(
             liquidityLabel,
             showThisLiquidity and showLiquidityText
                 ? displayLiquidityColor
                 : color(na)
        )

        if not na(liquidityPrice)
            label.set_y(liquidityLabel, liquidityPrice)

        showLabelsForThisSlot = (slot == 1) ? showLabelsCurrent : showLabelsOther
        showBox(
             array.get(oB, idx),
             visible,
             bg,
             bcol,
             tfText + " OB",
             showLabelsForThisSlot
        )

if showDebug and barstate.islast
    string fTops = ""
    if array.size(fB) > 0
        for i = 0 to array.size(fB) - 1
            fTops := fTops + (array.get(fBull, i) ? "" : str.tostring(array.get(fGrp, i)) + ":" + str.tostring(box.get_top(array.get(fB, i))) + " ")
    var label dbg = na
    label.delete(dbg)
    dbg := label.new(bar_index, close, 
       "fGrp size: " + str.tostring(array.size(fGrp)) + 
       "\noGrp size: " + str.tostring(array.size(oB)) + 
       "\nviB size: " + str.tostring(array.size(viB)) +
       "\ngiB size: " + str.tostring(array.size(giB)) +
       "\nfGrp: " + str.tostring(fGrp) + 
       "\noGrp: " + str.tostring(oGrp) +
       "\nfSlot: " + str.tostring(fSlot) +
       "\noSlot: " + str.tostring(oSlot) +
       "\nfBearTops: " + fTops,
       color = color.blue, textcolor = color.white, size = size.large)
